{
  description = "Spotify (Native on x86_64, FEX-emulated on ARM64)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
  };

  outputs = { self, nixpkgs }: let
    # Import Nixpkgs for x86_64
    pkgsX86 = import nixpkgs {
      system = "x86_64-linux";
      config.allowUnfree = true;
    };

    # Import Nixpkgs for ARM64
    pkgsArm = import nixpkgs {
      system = "aarch64-linux";
      config.allowUnfree = true;
    };
  in {
    packages = {
      # 1. When running on an x86_64 system, output the native app
      x86_64-linux.default = pkgsX86.spotify;

      # 2. When running on an ARM64 system, output the FEX-wrapped app
      aarch64-linux.default = pkgsArm.writeShellScriptBin "spotify" ''
        exec ${pkgsArm.fex}/bin/FEXBash ${pkgsX86.spotify}/bin/spotify "$@"
      '';
    };
  };
}
